{
  "name": "kylen-chat-for-twitch",
  "productName": "Kylen Chat for Twitch",
  "version": "1.1.1",
  "description": "Chat de Twitch transparente encima del juego, para streamers con una sola pantalla",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "npm run dist && node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "author": "Aleix Aj",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleixAj/kylenchat.git"
  },
  "build": {
    "appId": "com.kylen.twitchchat",
    "productName": "Kylen Chat for Twitch",
    "files": [
      "main.js",
      "preload.js",
      "i18n.js",
      "overlay.html",
      "overlay.js",
      "panel.html",
      "panel.js",
      "assets/**/*",
      "LICENSE",
      "!assets/readme/**",
      "!assets/logo-original.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "KylenChat-Portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "KylenChat-Setup.exe",
      "shortcutName": "Kylen Chat for Twitch"
    },
    "publish": {
      "provider": "github",
      "owner": "AleixAj",
      "repo": "kylenchat",
      "releaseType": "draft"
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US",
      "ca"
    ],
    "compression": "maximum"
  },
  "license": "MIT"
}
